# Stage 2/3B: one server, many sites. The first label of the Host picks the folder.
# Run with: caddy run --config /mnt/c/Users/indra/Code/mini-deploy/caddy/Caddyfile
# Apply changes without a restart: caddy reload --config <same path>

# Leading ":" = no hostname, so no HTTPS/certificate logic. Plain HTTP on 8080.
:8080 {
    # Who can connect: this machine, and the home Wi-Fi address for phone tests.
    # The Wi-Fi IP comes from the router and can change. If Caddy fails to start
    # with "cannot assign requested address", update it (ipconfig on Windows).
    # NEVER use 0.0.0.0 here without a firewall rule that limits who may connect.
    bind 127.0.0.1 192.168.40.241

    # The Host header is outside input. Only a valid app name (same rule as
    # the deploy script: ^[a-z0-9-]{1,40}$) may reach the filesystem path.
    # Captured name is available as {re.app.1}.
    #   app1.localhost                    <- this PC
    #   app1.192-168-40-241.nip.io        <- phone (nip.io answers with that LAN IP)
    @app header_regexp app Host ^([a-z0-9-]{1,40})\.(localhost|[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}\.nip\.io)(:[0-9]+)?$

    handle @app {
        # Final layout: /sites/<app>/current (a symlink from stage 3).
        root * /sites/{re.app.1}/current
        file_server
    }

    # Anything else (bad name, no subdomain) gets a plain 404, never a file.
    handle {
        respond "no such site" 404
    }
}
