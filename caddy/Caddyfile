# Stage 2/3B: one server, many sites. The first label of the Host picks the folder.
# Runs as the systemd service mini-deploy-caddy (systemd/mini-deploy-caddy.service),
# started through scripts/run-caddy.sh, which decides whether to listen on the Wi-Fi
# (at home only) and on the Tailscale network (while Tailscale is up; P5, below).
# Apply changes without a restart: systemctl reload mini-deploy-caddy

{
    # The admin API can replace the whole config. By default it listens on TCP
    # 127.0.0.1:2019 with no password, and in mirrored WSL networking any Windows
    # process shares that loopback. A unix socket is only reachable as root in WSL.
    admin unix//run/caddy-admin.sock
    # The phone sites below use HTTPS. Caddy would also open port 80 on every address to
    # redirect http to https there; nothing here may listen on all addresses, so no.
    auto_https disable_redirects
}

# P5: an app on the phone from anywhere, over the owner's own Tailscale network only.
# Tailscale gives this machine ONE certificate name (mini-deploy.tail206989.ts.net: no
# app.<name> subdomains), so each app gets its own port. Caddy asks the local tailscaled
# for that certificate (free, Let's Encrypt, renewed by itself). Port 443 on that name is
# the Funnel's (/webhook only), so apps start at 8443.
# Listens on 127.0.0.1 and, only while Tailscale is up, on the tailnet address that
# scripts/run-caddy.sh puts in MINI_DEPLOY_TAILNET_BIND: never on the Wi-Fi, never on
# 0.0.0.0. No proxy sits in front, so the connection's own address is the phone's: the
# admin and logs gates of :8080 are untouched, and neither page is served here at all.
# RULE: never `tailscale funnel` or `tailscale serve` on 8443 and up: that would put a phone
# app on the public internet (and fight Caddy for the port).
(phone_app) {
    bind 127.0.0.1 {$MINI_DEPLOY_TAILNET_BIND}
    tls {
        get_certificate tailscale
    }
    handle {
        # Cheaper Inference, exactly as on :8080 (the app calls /api/ci/... on its own origin)
        handle /api/ci/* {
            reverse_proxy 127.0.0.1:9200
        }
        @dotfile path_regexp (^|/)\.
        respond @dotfile 404
        header {
            Cache-Control "no-cache"
            X-Content-Type-Options "nosniff"
            # the phone address never leaks to the sites a page links to
            Referrer-Policy "no-referrer"
        }
        root * /sites/{args[0]}/current
        file_server
    }
}

# One line per app: its own port (the next free one). The admin page reads these lines to
# show each app's "phone (anywhere)" address, so keep this exact two-line shape.
https://mini-deploy.tail206989.ts.net:8443 {
    import phone_app aftersleep
}

https://mini-deploy.tail206989.ts.net:8444 {
    import phone_app yoomiread
}

# Leading ":" = no hostname, so no HTTPS/certificate logic. Plain HTTP on 8080.
:8080 {
    # Who can connect: this machine always; the home Wi-Fi address only when we are
    # really at home. scripts/run-caddy.sh fills MINI_DEPLOY_LAN_BIND with that address
    # only if this PC has the home address AND the router is the home router (its MAC,
    # saved in /etc/mini-deploy/home-lan by `run-caddy.sh remember-home`). Anywhere else
    # it is empty, so Caddy listens on this PC only (and starts on any network).
    # NEVER use 0.0.0.0 here without a firewall rule that limits who may connect.
    # Anyone on the home Wi-Fi can read every deployed site: only deploy public content.
    bind 127.0.0.1 {$MINI_DEPLOY_LAN_BIND}

    # The Host header is outside input. Only a valid app name (same rule as
    # the deploy script: ^[a-z0-9-]{1,40}$) may reach the filesystem path.
    # Captured name is available as {re.app.1}.
    #   app1.localhost                    <- this PC
    #   app1.192-168-40-241.nip.io        <- phone (nip.io answers with that LAN IP)
    @app header_regexp app Host ^([a-z0-9-]{1,40})\.(localhost|[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}\.nip\.io)(:[0-9]+)?$

    # Build logs: the full output of every build. That can hold paths, git messages and
    # (once apps have env vars) worse, so it is shown ONLY to this PC: the name must be
    # logs.localhost AND the connection must come from the loopback address. The phone,
    # anyone on the Wi-Fi and the Tailscale Funnel (which only forwards /webhook to port
    # 9000) never get it. "logs" is a reserved app name, so nothing else can claim it.
    # This block comes before @app, and Caddy tries `handle` blocks in this order.
    # Second gate: "from 127.0.0.1" is also true for anything on this PC that passes other
    # people's requests along (a proxy, `tailscale serve`). Proxies add these headers, so a
    # request carrying one is refused even from loopback. RULE: never put a proxy, Funnel or
    # `tailscale serve` in front of :8080. The Funnel forwards only /webhook to :9000.
    @logs {
        header_regexp Host ^logs\.localhost(:[0-9]+)?$
        remote_ip 127.0.0.1 ::1
        not header X-Forwarded-For *
        not header Forwarded *
        not header X-Real-IP *
        not header Tailscale-User-Login *
        not header Tailscale-Headers-Info *
    }
    handle @logs {
        # (a `handle`, not a bare `respond`: Caddy runs `handle` before `respond`, so a bare
        # respond here would never fire and temp files like .index.json.tmp would be served)
        @logdot path_regexp (^|/)\.
        handle @logdot {
            respond 404
        }
        header {
            Cache-Control "no-cache"
            X-Content-Type-Options "nosniff"
        }
        # /data/... = the log files and index.json written by scripts/buildlog.py
        handle_path /data/* {
            # A log is plain text, always: never let a browser guess another type.
            @logfile path *.log
            header @logfile Content-Type "text/plain; charset=utf-8"
            root * /var/log/mini-deploy/builds
            file_server
        }
        # everything else = the page itself, straight from the repo (it is not an app)
        handle {
            root * /mnt/c/Users/indra/Code/mini-deploy/web/logs
            file_server
        }
    }

    # Admin page (scripts/admin.py on 127.0.0.1:9300): same gate as the logs page, this PC
    # only and no proxy headers, THEN its own login, CSRF token and Origin check. "admin" is a
    # reserved app name, so from anywhere else admin.localhost falls through to @app and 404s.
    @admin {
        header_regexp Host ^admin\.localhost:8080$
        remote_ip 127.0.0.1 ::1
        not header X-Forwarded-For *
        not header Forwarded *
        not header X-Real-IP *
        not header Tailscale-User-Login *
        not header Tailscale-Headers-Info *
    }
    handle @admin {
        reverse_proxy 127.0.0.1:9300
    }

    handle @app {
        # Cheaper Inference for the apps (scripts/ci_forwarder.py, 127.0.0.1:9200). This is an
        # in-Caddy reverse proxy to a loopback service, for this one path only. It is NOT a
        # Funnel or tailscale serve in front of :8080 (that rule still holds). The forwarder
        # allowlists the paths and adds nothing: the phone's own key travels in the request.
        handle /api/ci/* {
            reverse_proxy 127.0.0.1:9200
        }

        # Never serve dotfiles or dot-folders (.env, .git/, .npmrc), at any depth.
        # (file_server's `hide` only matches the last path segment, so use a path match.)
        @dotfile path_regexp (^|/)\.
        respond @dotfile 404

        # A deploy must show up at once. Without this, browsers guess how long a page
        # stays fresh from its modification time and can keep serving the old release.
        # "no-cache" means: ask again every time. The ETag makes that a cheap 304.
        # nosniff: a browser must trust the file type Caddy names, never guess it.
        header {
            Cache-Control "no-cache"
            X-Content-Type-Options "nosniff"
        }

        # Final layout: /sites/<app>/current (a symlink from stage 3).
        root * /sites/{re.app.1}/current
        file_server
    }

    # Anything else (bad name, no subdomain) gets a plain 404, never a file.
    handle {
        respond "no such site" 404
    }
}
