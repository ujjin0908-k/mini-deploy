# Stage 2/3B: one server, many sites. The first label of the Host picks the folder.
# Run with: caddy run --config /mnt/c/Users/indra/Code/mini-deploy/caddy/Caddyfile
# Apply changes without a restart: caddy reload --config <same path>

{
    # The admin API can replace the whole config. By default it listens on TCP
    # 127.0.0.1:2019 with no password, and in mirrored WSL networking any Windows
    # process shares that loopback. A unix socket is only reachable as root in WSL.
    admin unix//run/caddy-admin.sock
}

# Leading ":" = no hostname, so no HTTPS/certificate logic. Plain HTTP on 8080.
:8080 {
    # Who can connect: this machine, and the home Wi-Fi address for phone tests.
    # The Wi-Fi IP comes from the router and can change. If Caddy fails to start
    # with "cannot assign requested address", update it (ipconfig on Windows).
    # NEVER use 0.0.0.0 here without a firewall rule that limits who may connect.
    # Anyone on that Wi-Fi can read every deployed site: only deploy public content.
    bind 127.0.0.1 192.168.40.241

    # The Host header is outside input. Only a valid app name (same rule as
    # the deploy script: ^[a-z0-9-]{1,40}$) may reach the filesystem path.
    # Captured name is available as {re.app.1}.
    #   app1.localhost                    <- this PC
    #   app1.192-168-40-241.nip.io        <- phone (nip.io answers with that LAN IP)
    @app header_regexp app Host ^([a-z0-9-]{1,40})\.(localhost|[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}\.nip\.io)(:[0-9]+)?$

    # Build logs: the full output of every build. That can hold paths, git messages and
    # (once apps have env vars) worse, so it is shown ONLY to this PC: the name must be
    # logs.localhost AND the connection must come from the loopback address. The phone,
    # anyone on the Wi-Fi and the Tailscale Funnel (which only forwards /webhook to port
    # 9000) never get it. "logs" is a reserved app name, so nothing else can claim it.
    # This block comes before @app, and Caddy tries `handle` blocks in this order.
    @logs {
        header_regexp Host ^logs\.localhost(:[0-9]+)?$
        remote_ip 127.0.0.1 ::1
    }
    handle @logs {
        # (a `handle`, not a bare `respond`: Caddy runs `handle` before `respond`, so a bare
        # respond here would never fire and temp files like .index.json.tmp would be served)
        @logdot path_regexp (^|/)\.
        handle @logdot {
            respond 404
        }
        header {
            Cache-Control "no-cache"
            X-Content-Type-Options "nosniff"
        }
        # /data/... = the log files and index.json written by scripts/buildlog.py
        handle_path /data/* {
            root * /var/log/mini-deploy/builds
            file_server
        }
        # everything else = the page itself, straight from the repo (it is not an app)
        handle {
            root * /mnt/c/Users/indra/Code/mini-deploy/web/logs
            file_server
        }
    }

    handle @app {
        # Never serve dotfiles or dot-folders (.env, .git/, .npmrc), at any depth.
        # (file_server's `hide` only matches the last path segment, so use a path match.)
        @dotfile path_regexp (^|/)\.
        respond @dotfile 404

        # A deploy must show up at once. Without this, browsers guess how long a page
        # stays fresh from its modification time and can keep serving the old release.
        # "no-cache" means: ask again every time. The ETag makes that a cheap 304.
        # nosniff: a browser must trust the file type Caddy names, never guess it.
        header {
            Cache-Control "no-cache"
            X-Content-Type-Options "nosniff"
        }

        # Final layout: /sites/<app>/current (a symlink from stage 3).
        root * /sites/{re.app.1}/current
        file_server
    }

    # Anything else (bad name, no subdomain) gets a plain 404, never a file.
    handle {
        respond "no such site" 404
    }
}
