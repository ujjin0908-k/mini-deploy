# One check: did the network change (arrived home / left home)? If so, reload Caddy so it
# listens on the home Wi-Fi only while at home. Started every 30 s by the .timer.
[Unit]
Description=mini-deploy: match Caddy's listening addresses to the current network
After=mini-deploy-caddy.service
# Only while Caddy runs (its admin socket exists). A condition just skips the run quietly;
# a dependency (Requisite=) would log a failure every 30 s while Caddy is down.
ConditionPathExists=/run/caddy-admin.sock
RequiresMountsFor=/mnt/c/Users/indra/Code/mini-deploy

[Service]
Type=oneshot
ExecStart=/bin/bash /mnt/c/Users/indra/Code/mini-deploy/scripts/run-caddy.sh sync
